---
// about-us.astro - About Us page
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Sreemitra - About Us" currentPath="about-us.html" description="Learn about Sreemitra's legacy of building trust and securing futures through premium plotted developments across AP & TS since 1994.">

  <!-- Main Content Canvas -->
  <main class="pt-32 pb-24 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <!-- Hero Section -->
    <section class="mb-32 text-center">
      <h1 class="font-urbanist text-display-lg text-charcoal mb-6 max-w-4xl mx-auto">Turning Locations Into Legacies Since 1994.</h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">Plotted developments built on research, relationships, and results.</p>
    </section>

    <!-- Our Story -->
    <section class="mb-32 grid grid-cols-1 md:grid-cols-12 gap-gutter items-center">
      <div class="md:col-span-5 mb-12 md:mb-0">
        <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-charcoal mb-6">Our Story</h2>
        <h3 class="font-body-lg text-body-lg text-brass-accent mb-4 italic">From Emerging Outskirts to Established Corridors</h3>
        <p class="mb-6 text-on-surface-variant">For nearly three decades, we have been identifying land parcels that transform into thriving communities. Our approach is deeply rooted in empirical research, understanding infrastructural growth patterns, and building enduring relationships with our clients.</p>
        <p class="text-on-surface-variant">We don't just sell plots; we curate environments where value appreciates organically, ensuring every investment is a foundation for future generations.</p>
      </div>
      <div class="md:col-span-6 md:col-start-7">
        <div class="bg-surface-container-lowest border border-surface-variant p-8 shadow-sm rounded-lg">
          <img class="w-full h-[400px] object-cover grayscale hover:grayscale-0 transition-all duration-700 rounded-DEFAULT"
            data-alt="A vintage black and white photograph of an empty landscape slowly transitioning into a modern architectural rendering of a serene, plotted development with lush greenery."
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuDu1nze6Kfq-JWN50L_Jc8hm_sdMpd7hNLYs57EV7e7tG0O-ExtCGBvIoGIWHFpiA9L9KxO3b6j5jVT14pjNzpUnT6p6eG4aU-BuBQ6v1QMQ_SZe78BMLOpKTqT0UlYzC3Bw5W54PFbUQv8uQpWRvvaVRf6Jz6Y5pQWsBGyzhLTWgRNAztnSGXg4JHnW8oZQeX8egQ_ClRl0PeLXNwXCFWc0thOYsaEZ8PyT-0R3BzI12vJFxX1bJtu" />
        </div>
      </div>
    </section>

    <!-- Leadership Section -->
    <section class="mb-32">
      <div class="text-center mb-16">
        <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-charcoal mb-4">Leadership</h2>
        <div class="w-16 h-px bg-surface-variant mx-auto"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
        <!-- Leader 1 -->
        <div class="group">
          <div class="bg-surface-container-lowest border border-surface-variant p-6 mb-6 transition-all duration-500 group-hover:-translate-y-2 rounded-lg">
            <img class="w-full h-[350px] object-cover filter contrast-125 sepia-[.2] rounded-DEFAULT"
              data-alt="A professional portrait of a senior male executive in a finely tailored dark suit"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuA25xmo0-6vdmOE0R1TnzefHiwzhNiSSpXvjC79LXzImvcBnxKB84CtudLeqEaFNAFh-qkQrEBLfjmN1fjfbBDRfUtpxeBDUrs1CGs41EWmYKxykQEvRaJyST2b9NcE3ytZZiMi3xZqVN_wNvc1h_GCDbJmgbrKH5u57DNPUKZ985Vy74NNxFzOusNMCapPzoL_UW_AvCX5vHitDLlKtPsVFVnoRnTLUrj_H8ZD-N31UFFNT_QuoSV1" />
          </div>
          <h3 class="font-headline-md text-headline-md text-charcoal mb-1">M. Venkata Chowdary</h3>
          <p class="font-label-caps text-label-caps uppercase text-on-surface-variant">Founder & MD</p>
        </div>
        <!-- Leader 2 -->
        <div class="group">
          <div class="bg-surface-container-lowest border border-surface-variant p-6 mb-6 transition-all duration-500 group-hover:-translate-y-2 rounded-lg">
            <img class="w-full h-[350px] object-cover filter contrast-125 sepia-[.2] rounded-DEFAULT"
              data-alt="A professional portrait of a confident young male executive"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuDNAo0XYi732vwjTkvVFU9kmyN3MLRSZ4jeC__Ztk3lqLYmAJyPO7wtvVsRlmUzFowpPsLHrZjAIFT6erVJdrvQw6EHJV0xL_u3Nqj8MZdQx2IsG-X1d5XsY2uKGmhGP3K4w4KDZ_oa-65LCUq0JL0d62XWTDwQBr-VrvokhMmivce0cMaOwLxn3IFx2VI9aZfuGvuHW-iuybY7Mhxrl6PoFbOYy2WlOfMudfvDCTNkgpZoz_VX58Eu" />
          </div>
          <h3 class="font-headline-md text-headline-md text-charcoal mb-1">Teja Govind Medikonduri</h3>
          <p class="font-label-caps text-label-caps uppercase text-on-surface-variant">Director</p>
        </div>
        <!-- Leader 3 -->
        <div class="group">
          <div class="bg-surface-container-lowest border border-surface-variant p-6 mb-6 transition-all duration-500 group-hover:-translate-y-2 rounded-lg">
            <img class="w-full h-[350px] object-cover filter contrast-125 sepia-[.2] rounded-DEFAULT"
              data-alt="A professional portrait of a dynamic young male executive"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuA2pTYmaeSIZAyuM0THOuiLjtlnVhpVWiowkbdqHurIQ2oJ1twHuh4wDMSVoiDG_E_xs0Qt7YBnJHCAPaUBxvPrjIUpNI-Xs8oW9Wq86JdlLZrGnjDyCSoTbDTpgWAnHbC5OsjkFytLSjBakMdFHUZkAm2bMHqwnPUGNKK9-Lt6V7mYtRB7z1zzYX1vR1iHFKjqBp7Ru4chX6zDCSi_6az1zrTLHzuAbtAYa36Qu7_r8kfcgG_LfbTj" />
          </div>
          <h3 class="font-headline-md text-headline-md text-charcoal mb-1">Teja Nivas Medikonduri</h3>
          <p class="font-label-caps text-label-caps uppercase text-on-surface-variant">Director</p>
        </div>
      </div>
    </section>

    <!-- Enduring Trust Slider Section -->
    <section class="mb-24 bg-surface-container-lowest border border-surface-variant py-16 px-6 md:px-16 relative rounded-xl" id="enduring-trust-section">
      <div aria-hidden="true" class="absolute top-8 left-8 text-[#0c3c46]/25 text-9xl font-headline-lg leading-none select-none pointer-events-none">"</div>

      <div class="text-center mb-10 relative z-10">
        <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-charcoal">Customer Voices</h2>
        <p class="font-body-md text-on-surface-variant mt-2 max-w-xl mx-auto">What buyers and plot owners say</p>
      </div>

      <div class="max-w-4xl mx-auto relative z-10">
        <div class="relative px-12 sm:px-16 trust-slider-wrapper">
          <!-- Slider Track / Slides -->
          <div class="min-h-[200px] flex items-center justify-center relative" id="trust-slider-track">
            <!-- Slide 1 -->
            <div class="trust-slide text-center w-full block">
              <p class="font-body-lg text-body-lg text-on-surface-variant italic mb-8 max-w-2xl mx-auto leading-relaxed">
                "Investing with Sreemitra wasn't just a transaction; it was a partnership for the long haul. Their foresight in identifying growth corridors allowed our family to secure a valuable asset that has appreciated beyond our expectations."
              </p>
              <div class="flex items-center justify-center space-x-4">
                <div class="w-12 h-12 rounded-full overflow-hidden border border-surface-variant shadow-sm">
                  <img alt="Rajiv Menon" class="w-full h-full object-cover"
                    data-alt="A close-up portrait of a satisfied client"
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuAcV9PO_SC_D3HBWe2bJRTqzW6nmAjN0uofquy7D2osLFZjwCRZqGyeWsAwdZukRWq2bCy27_nFlqcD3Ft3cChIRAE2gLR9l0irDEOuU86j-ljlvl56paY2a5041phbLotPx2qKQrTFscRhHrpt89a0tMkjU_ln7M6hKrk0XB8oZACakUxbh5YN2SPOo8yKq9L7_diZNvyPmHcausY7GgtFEYyVEC3-bA9PRIAzUEUenA4AikKXpPKI" />
                </div>
                <div class="text-left">
                  <p class="font-label-caps text-label-caps text-charcoal uppercase font-semibold">Rajiv Menon</p>
                  <p class="font-body-md text-sm text-on-surface-variant">Early Investor</p>
                </div>
              </div>
            </div>

            <!-- Slide 2 -->
            <div class="trust-slide text-center w-full hidden">
              <p class="font-body-lg text-body-lg text-on-surface-variant italic mb-8 max-w-2xl mx-auto leading-relaxed">
                "The legal transparency and clear title guarantees provided by Sreemitra gave me complete peace of mind. Their team guided us seamlessly through every documentation step."
              </p>
              <div class="flex items-center justify-center space-x-4">
                <div class="w-12 h-12 rounded-full overflow-hidden border border-surface-variant shadow-sm">
                  <img alt="Dr. Ananya Rao" class="w-full h-full object-cover"
                    data-alt="Portrait of Dr. Ananya Rao"
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuDu1nze6Kfq-JWN50L_Jc8hm_sdMpd7hNLYs57EV7e7tG0O-ExtCGBvIoGIWHFpiA9L9KxO3b6j5jVT14pjNzpUnT6p6eG4aU-BuBQ6v1QMQ_SZe78BMLOpKTqT0UlYzC3Bw5W54PFbUQv8uQpWRvvaVRf6Jz6Y5pQWsBGyzhLTWgRNAztnSGXg4JHnW8oZQeX8egQ_ClRl0PeLXNwXCFWc0thOYsaEZ8PyT-0R3BzI12vJFxX1bJtu" />
                </div>
                <div class="text-left">
                  <p class="font-label-caps text-label-caps text-charcoal uppercase font-semibold">Dr. Ananya Rao</p>
                  <p class="font-body-md text-sm text-on-surface-variant">Plot Owner, Vijayawada</p>
                </div>
              </div>
            </div>

            <!-- Slide 3 -->
            <div class="trust-slide text-center w-full hidden">
              <p class="font-body-lg text-body-lg text-on-surface-variant italic mb-8 max-w-2xl mx-auto leading-relaxed">
                "As NRI investors living in the US, trusting a remote developer is crucial. Sreemitra kept us updated at every milestone and delivered high-quality icons right on schedule."
              </p>
              <div class="flex items-center justify-center space-x-4">
                <div class="w-12 h-12 rounded-full overflow-hidden border border-surface-variant shadow-sm">
                  <img alt="Vikram & Sunita Sharma" class="w-full h-full object-cover"
                    data-alt="Portrait of Vikram & Sunita Sharma"
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuDNAo0XYi732vwjTkvVFU9kmyN3MLRSZ4jeC__Ztk3lqLYmAJyPO7wtvVsRlmUzFowpPsLHrZjAIFT6erVJdrvQw6EHJV0xL_u3Nqj8MZdQx2IsG-X1d5XsY2uKGmhGP3K4w4KDZ_oa-65LCUq0JL0d62XWTDwQBr-VrvokhMmivce0cMaOwLxn3IFx2VI9aZfuGvuHW-iuybY7Mhxrl6PoFbOYy2WlOfMudfvDCTNkgpZoz_VX58Eu" />
                </div>
                <div class="text-left">
                  <p class="font-label-caps text-label-caps text-charcoal uppercase font-semibold">Vikram & Sunita Sharma</p>
                  <p class="font-body-md text-sm text-on-surface-variant">NRI Investors, USA</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Navigation Arrows -->
          <button aria-label="Previous Slide" id="trust-prev-btn"
            class="absolute left-0 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-brass-accent text-white flex items-center justify-center z-10 cursor-pointer border-none shadow-lg hover:bg-[#1e753d] transition-all duration-300" style="opacity: 1;">
            <svg fill="none" height="24" stroke="#ffffff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" viewBox="0 0 24 24" width="24">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>

          <button aria-label="Next Slide" id="trust-next-btn"
            class="absolute right-0 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-brass-accent text-white flex items-center justify-center z-10 cursor-pointer border-none shadow-lg hover:bg-[#1e753d] transition-all duration-300 opacity-100"  style="opacity: 1;">
            <svg fill="none" height="24" stroke="#ffffff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" viewBox="0 0 24 24" width="24">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>

        <!-- Pagination Dots -->
        <div class="flex justify-center space-x-3 mt-10" id="trust-dots">
          <button aria-label="Slide 1" class="trust-dot w-3 h-3 rounded-full transition-all duration-300 focus:outline-none cursor-pointer" style="background-color: #0c3c46;"></button>
          <button aria-label="Slide 2" class="trust-dot w-3 h-3 rounded-full transition-all duration-300 focus:outline-none cursor-pointer" style="background-color: #cfc4c5;"></button>
          <button aria-label="Slide 3" class="trust-dot w-3 h-3 rounded-full transition-all duration-300 focus:outline-none cursor-pointer" style="background-color: #cfc4c5;"></button>
        </div>
      </div>
    </section>
  </main>

</BaseLayout>