---
// growth-corridors.astro - Growth Corridors page
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Growth Corridors - Sreemitra" currentPath="growth-corridors.html" description="Explore Sreemitra's strategic growth corridors methodology - infrastructure, industry, connectivity, and people services that drive land appreciation in Hyderabad and Visakhapatnam.">

  <!-- Main Content Canvas -->
  <main class="pt-[140px] pb-32">
    <div class="max-w-container-max mx-auto px-margin-desktop bg-surface-container-lowest min-h-screen">
      <!-- Hero Section -->
      <section class="py-20 md:py-28 grid grid-cols-1 md:grid-cols-12 gap-12 items-center relative">
        <div class="md:col-span-7 z-10">
          <h1 class="font-urbanist text-display-lg text-charcoal mb-8 max-w-3xl leading-tight">
            We Don't Guess Locations. <br><span class="text-brass-accent italic">We Study Them.</span>
          </h1>
          <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mb-12">
            Growth corridors chosen through data, policy, and on-ground trends. Our methodology transforms speculation into calculated foresight, curating legacy through premium land investments.
          </p>
          <a class="inline-flex items-center gap-2 border border-charcoal px-8 py-4 font-label-caps text-label-caps uppercase tracking-widest hover:bg-charcoal hover:text-surface-container-lowest transition-colors duration-300 group" href="/contact-us.html">
            Explore Projects in Growth Corridors
            <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </a>
        </div>
        <div class="md:col-span-5 z-10">
          <div class="w-full h-[400px] md:h-[460px] rounded-2xl overflow-hidden shadow-2xl border border-outline-variant/40 relative group">
            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" alt="Urban Growth Corridors Infrastructure & Planning"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuD08PNNg3OJpiU_-7g3OIe89HeJujBCMoViuTEhs3US3N7ttIbVW-2l6S0UJDU0RJTs68OW1ObkmAcDH1jiu9pwdbqjdX-4la4itjoY_TPB9Hidaab2YjFonfq5VsXSt8jkxSejjqijSGMMIofN1Fk7Rp4lU0WYeZbFEFLitZuZxKBLY-KCH3RvnbdLBPRXJzx8AT6-VjqKUVBJVNN4h41Il1ZLMzPus3vxI4X212rNfqblLDrJQEuu" />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal/20 via-transparent to-transparent"></div>
          </div>
        </div>
      </section>

      <!-- Drivers Grid Section -->
      <section class="py-24 border-t border-surface-container-high relative">
        <div class="absolute -top-[1px] left-0 w-24 border-t border-brass-accent"></div>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-0 border-l border-surface-container-high">
          <!-- Driver 1: Infrastructure -->
          <div class="p-10 border-r border-b border-surface-container-high group hover:bg-surface-bright transition-colors duration-500">
            <span class="material-symbols-outlined text-4xl text-primary mb-8 block group-hover:text-brass-accent transition-colors">architecture</span>
            <h3 class="font-headline-md text-headline-md text-charcoal mb-4">Infrastructure</h3>
            <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
              Proximity to major highways, proposed metro lines, and arterial road networks forming the backbone of future appreciation.
            </p>
          </div>
          <!-- Driver 2: Industry & IT -->
          <div class="p-10 border-r border-b border-surface-container-high group hover:bg-surface-bright transition-colors duration-500">
            <span class="material-symbols-outlined text-4xl text-primary mb-8 block group-hover:text-brass-accent transition-colors">business</span>
            <h3 class="font-headline-md text-headline-md text-charcoal mb-4">Industry & IT</h3>
            <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
              Tracking commercial zoning, tech park expansions, and industrial hubs that drive employment and residential demand.
            </p>
          </div>
          <!-- Driver 3: Connectivity -->
          <div class="p-10 border-r border-b border-surface-container-high group hover:bg-surface-bright transition-colors duration-500">
            <span class="material-symbols-outlined text-4xl text-primary mb-8 block group-hover:text-brass-accent transition-colors">route</span>
            <h3 class="font-headline-md text-headline-md text-charcoal mb-4">Connectivity</h3>
            <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
              Evaluating transit nodes, airport proximity, and inter-city links ensuring seamless integration with existing urban centers.
            </p>
          </div>
          <!-- Driver 4: People & Services -->
          <div class="p-10 border-r border-b border-surface-container-high group hover:bg-surface-bright transition-colors duration-500">
            <span class="material-symbols-outlined text-4xl text-primary mb-8 block group-hover:text-brass-accent transition-colors">groups</span>
            <h3 class="font-headline-md text-headline-md text-charcoal mb-4">People & Services</h3>
            <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
              Assessing demographic shifts, educational institutions, and healthcare facilities that anchor sustainable communities.
            </p>
          </div>
        </div>
      </section>

      <!-- Visual Break / Image Full Width -->
      <section class="py-16">
        <div class="w-full h-[500px] relative overflow-hidden">
          <div class="bg-cover bg-center w-full h-full grayscale opacity-80 mix-blend-multiply"
            data-alt="A striking digital visualization of an urban growth corridor."
            style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuD08PNNg3OJpiU_-7g3OIe89HeJujBCMoViuTEhs3US3N7ttIbVW-2l6S0UJDU0RJTs68OW1ObkmAcDH1jiu9pwdbqjdX-4la4itjoY_TPB9Hidaab2YjFonfq5VsXSt8jkxSejjqijSGMMIofN1Fk7Rp4lU0WYeZbFEFLitZuZxKBLY-KCH3RvnbdLBPRXJzx8AT6-VjqKUVBJVNN4h41Il1ZLMzPus3vxI4X212rNfqblLDrJQEuu')">
          </div>
        </div>
      </section>
    </div>
  </main>

</BaseLayout>