            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              data-alt="A serene landscape rendering of a future residential layout"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuA208GgLLGX9jrXfBhwFtcBAIc6pkDBCwQC52EJiDyjz54B4C_24ljpxaNN1wjhyojX6miqzp7-arL7kQRXBr57fZTES5BKTOTcJXEc5PKHINwGaRvVhDEwIaTi8zcMb5HoF_36XKToV6ke2g4pEZ1gdwr6f8uQeFKedzMJ2w7Ioalmv0VurK-NwmRE8rkB5EcCjGQJ7OoaUS8JCJyC93V2h9Mv2Mc0dDtS8ONi6FIPd5_hpjG32kuF" />
