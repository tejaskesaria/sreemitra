---
// projects.astro - Projects page
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Sreemitra - Projects" currentPath="projects.html" description="Discover Sreemitra's portfolio of thoughtfully planned spaces - ongoing, upcoming, and completed plotted development projects across Hyderabad and Visakhapatnam.">

  <main class="pt-[120px] pb-24 page-container min-h-screen">
    <!-- Hero Section -->
    <section class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto mb-24">
      <h1 class="font-urbanist text-display-lg text-charcoal mb-8 max-w-4xl leading-tight">Projects That Grow With <span class="text-muted-gold italic">Their Surroundings.</span></h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl">Plotted layouts, townships and apartments across Hyderabad, Visakhapatnam and Vizianagaram. See what is selling now and what we have already delivered.</p>
    </section>

    <!-- Ongoing Projects -->
    <section class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto mb-32">
      <div class="flex items-center gap-4 mb-12 border-b border-surface-container-high pb-4">
        <span class="font-headline-md text-headline-md text-charcoal">01</span>
        <h2 class="font-headline-lg text-headline-lg text-charcoal">Ongoing Projects</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <!-- Project Card 1 -->
        <article class="bg-surface-container-lowest border border-surface-container-high group hover:-translate-y-1 transition-transform duration-300 flex flex-col">
          <div class="relative w-full h-[400px] overflow-hidden">
            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
