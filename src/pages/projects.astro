              src="https://lh3.googleusercontent.com/aida-public/AB6AXuBiTF1MmZPiHaqFM0vP5R5VGgmwvn2qxZlywZcX7p8UJZG6mbGZ9uasxhClFYYHrznNxYNaPnQrrdZ5-CBXlL3QbaVOnG2gejBYh-Om0txdk4m9LMSqQZQu2URVyHe664DxUVpm0W-XBN7bgo5Fm87narbnvCeH48-kuABnWhOkYbiXBpN3FJDf8t0qhnHCrOznpMLOdNOswOYb3h4-smcaCsLoUoAspBjcJIzXXJV9-jBhJyq07MP4" />
            <div class="absolute top-4 right-4 bg-surface-container-lowest/90 backdrop-blur-sm px-3 py-1 font-label-caps text-label-caps uppercase tracking-widest text-primary border border-surface-container-high">
              HMDA Approved
            </div>
          </div>
          <div class="p-8 flex-grow flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-start mb-4">
                <h3 class="font-headline-md text-headline-md text-charcoal">Orchid Blooms</h3>
              </div>
              <p class="font-body-md text-body-md text-on-surface-variant mb-6">A plotted layout on JP Dargah Road in Kothur, close to the HyderabadBengaluru highway (NH-44), in an industrial and logistics belt south of Shamshabad airport. Roads, underground power and drainage, avenue trees, parks and round-theclock security.</p>
            </div>
            <div class="border-t border-surface-container-high pt-6 mt-4">
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <span class="block font-label-caps text-label-caps text-outline mb-1 uppercase tracking-widest">Location</span>
                  <span class="font-body-md text-body-md text-charcoal">Kothur, Hyderabad</span>
                </div>
                <div>
                  <span class="block font-label-caps text-label-caps text-outline mb-1 uppercase tracking-widest">Status</span>
                  <span class="font-body-md text-body-md text-charcoal">Now selling. HMDA LP No. 000308/LO/PLg/HMDA/2021. TG RERA No. TG/2021/000308</span>
                </div>
              </div>
              <button class="mt-8 w-full border border-outline-variant/30 py-3 font-label-caps text-label-caps uppercase tracking-widest text-charcoal hover:bg-surface-container-high transition-colors">View Project</button>
